{{- /*
  Relatório semanal do notas.lauraesteves.com.
  Visual copiado do health report do server-apps (server-apps/scripts/health-report.sh):
  mesma paleta, card de 600px, faixa ciano->roxo no topo e o avatar do Cortex inline (cid).

  Dados (WeeklyReport):
    Subject      string           "Servidores | Notas da Semana: 2026-11-23"
    Preview      string           texto escondido que aparece na lista de e-mails
    AvatarSrc    string           "cid:cortex@lauraesteves.com" em produção, caminho do arquivo no preview local
    Now          string           "23/11/2026 09:00"
    Total        int              notas no banco
    EditedWeek   int              notas editadas nos últimos 7 dias
    Recent       []RecentNote     até 10, mais recente primeiro
      Path       string           "faculdade/calculo" (já normalizado: [a-z0-9_-/])
      EditedAt   string           "22/11 18:42"
    SiteURL      string           "https://notas.lauraesteves.com"
    Host         string           nome da Lambda que enviou
*/ -}}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:0;background-color:#0f0f1a;font-family:Montserrat,'Segoe UI',Helvetica,Arial,sans-serif;color:#e7ecf2;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{.Preview}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#0f0f1a;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#1a1a2e;border-radius:20px;overflow:hidden;text-align:left;">
        <tr>
          <td style="height:6px;line-height:6px;font-size:0;background-color:#00f0f9;background-image:linear-gradient(90deg,#00f0f9,#a955ff);">&nbsp;</td>
        </tr>
        <tr>
          <td style="padding:32px 32px 0 32px;">
            {{- if .AvatarSrc}}
            <img src="{{.AvatarSrc}}" width="48" height="48" alt="Cortex" style="display:block;width:48px;height:48px;border-radius:50%;margin:0 0 16px 0;">
            {{- end}}
            <p style="margin:0 0 8px 0;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#00f0f9;">Relatório semanal</p>
            <h1 style="margin:0 0 12px 0;font-size:24px;line-height:1.3;color:#ffffff;">Notas | notas.lauraesteves.com</h1>
            <p style="margin:12px 0 0 0;font-size:13px;color:#8a8fa3;">{{.Now}} · últimos 7 dias</p>
          </td>
        </tr>
        <tr>
          <td style="padding:24px 32px 0 32px;">
            <p style="margin:0 0 12px 0;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#00f0f9;">Banco</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="50%" style="padding:6px;vertical-align:top;">
                  <div style="background-color:#0f0f1a;border-radius:12px;padding:16px;">
                    <p style="margin:0 0 6px 0;font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#a955ff;">Notas no banco</p>
                    <p style="margin:0;font-size:22px;font-weight:700;color:#ffffff;">{{.Total}}</p>
                    <p style="margin:2px 0 0 0;font-size:12px;color:#8a8fa3;">ativas, expiram 15 dias após a última edição</p>
                  </div>
                </td>
                <td width="50%" style="padding:6px;vertical-align:top;">
                  <div style="background-color:#0f0f1a;border-radius:12px;padding:16px;">
                    <p style="margin:0 0 6px 0;font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#a955ff;">Editadas na semana</p>
                    <p style="margin:0;font-size:22px;font-weight:700;color:{{if .EditedWeek}}#00f0f9{{else}}#ffffff{{end}};">{{.EditedWeek}}</p>
                    <p style="margin:2px 0 0 0;font-size:12px;color:#8a8fa3;">notas com alteração em 7 dias</p>
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:24px 32px 0 32px;">
            <p style="margin:0 0 12px 0;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#00f0f9;">Últimas 10 editadas</p>
            {{- if .Recent}}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <th style="padding:0 8px 8px 0;font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#8a8fa3;text-align:left;font-weight:600;">Caminho</th>
                <th style="padding:0 0 8px 0;font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#8a8fa3;text-align:right;font-weight:600;">Editada em</th>
              </tr>
              {{- range .Recent}}
              <tr>
                <td style="padding:10px 8px 10px 0;border-top:1px solid #2a2a44;font-family:SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;color:#e7ecf2;vertical-align:top;word-break:break-all;">
                  <a href="{{$.SiteURL}}/{{.Path}}" style="color:#e7ecf2;text-decoration:none;"><span style="color:#8a8fa3;">/</span>{{.Path}}</a>
                </td>
                <td style="padding:10px 0 10px 0;border-top:1px solid #2a2a44;font-size:12px;color:#8a8fa3;vertical-align:top;text-align:right;white-space:nowrap;">{{.EditedAt}}</td>
              </tr>
              {{- end}}
            </table>
            {{- else}}
            <p style="margin:0;font-size:14px;color:#f59e0b;">Nenhuma nota editada nesta semana.</p>
            {{- end}}
          </td>
        </tr>
        <tr>
          <td style="padding:32px 32px 0 32px;">&nbsp;</td>
        </tr>
        <tr>
          <td style="padding:20px 32px;border-top:1px solid #2a2a44;font-size:12px;line-height:1.8;color:#8a8fa3;">
            <a href="{{.SiteURL}}" style="color:#00f0f9;text-decoration:none;">Notas</a> · <a href="https://us-east-1.console.aws.amazon.com/dynamodbv2/home?region=us-east-1#tables" style="color:#00f0f9;text-decoration:none;">DynamoDB</a> · <a href="https://us-east-1.console.aws.amazon.com/cloudwatch/home?region=us-east-1#logsV2:log-groups" style="color:#00f0f9;text-decoration:none;">CloudWatch</a><br>
            Enviado em {{.Now}} por {{.Host}}
          </td>
        </tr>
      </table>
      <p style="margin:16px 0 0 0;font-size:12px;color:#8a8fa3;">lauraesteves.com</p>
    </td>
  </tr>
</table>
</body>
</html>
