# Copie para .env.prod (ignorado pelo git) e preencha.
# Certificado ACM em us-east-1 cobrindo notas.lauraesteves.com (e *.notas.lauraesteves.com).
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000
# Hosted zone do Route53 de lauraesteves.com.
HOSTED_ZONE_ID=Z0000000000000000000

# Opcionais (os padrões estão no Makefile)
# STACK_NAME=notas-lauraesteves-frontend
# AWS_REGION=us-east-1
